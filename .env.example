# Two-letter state code for your METRC instance (ok, ca, co, mi, ...)
METRC_STATE=ok

# Vendor API key — identifies the software integrator to METRC
METRC_VENDOR_API_KEY=

# User API key — generated from your METRC user profile; scopes facility access
METRC_USER_API_KEY=

# Optional: default facility license number, used when a tool call omits one
METRC_LICENSE_NUMBER=

# Target the state sandbox instead of production. Start here.
METRC_SANDBOX=true

# Write operations (finish_package, ...) stay disabled unless this is true.
# Test against the sandbox before ever enabling this in production.
METRC_ALLOW_WRITES=false

# Request timeout in milliseconds
METRC_TIMEOUT_MS=30000
